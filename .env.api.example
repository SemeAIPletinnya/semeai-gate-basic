SEMEAI_GATE_API_KEYS=replace-with-long-random-pilot-key
SEMEAI_GATE_API_KEY_PLANS={"replace-with-long-random-pilot-key":"pilot"}
SEMEAI_GATE_ADMIN_KEY=replace-with-long-random-admin-key
SEMEAI_GATE_HOST=0.0.0.0
SEMEAI_GATE_PORT=8787
SEMEAI_GATE_RECEIPT_DIR=/app/outputs/api_receipts
SEMEAI_GATE_ACCOUNT_DIR=/app/outputs/api_accounts
# Optional dedicated root; defaults beneath SEMEAI_GATE_ACCOUNT_DIR.
SEMEAI_GATE_SKILL_DIR=
# Dedicated operator authority for skill decisions. It is not a Gate key.
SEMEAI_GATE_SKILL_AUTHORITY_KEY=
# ADMITTED decisions remain disabled unless the operator explicitly enables them.
SEMEAI_GATE_SKILL_ADMISSION_ENABLED=false
SEMEAI_GATE_USDT_TRC20_ADDRESS=TJmrrUrpsRpG3u9H4FE9oVyCRPYQYEpG27
SEMEAI_GATE_MANUAL_USDT_AMOUNT=25.00
SEMEAI_GATE_OPERATOR_EMAIL=anton_semenenko@semeai.tech
SEMEAI_GATE_FEEDBACK_EMAIL=support@semeai.tech
SEMEAI_GATE_PUBLIC_SITE_URL=https://semeai.tech
SEMEAI_GATE_CORS_ORIGINS=https://semeai.tech,https://www.semeai.tech,https://gate.semeai.tech
# Email provider (Resend recommended). Without a key, emails go to durable outbox.
SEMEAI_GATE_RESEND_API_KEY=
SEMEAI_GATE_EMAIL_FROM=SemeAI Gate <noreply@semeai.tech>
SEMEAI_GATE_EMAIL_FROM_NAME=SemeAI Gate
# Optional SMTP alternative:
# SEMEAI_GATE_SMTP_HOST=
# SEMEAI_GATE_SMTP_PORT=587
# SEMEAI_GATE_SMTP_USER=
# SEMEAI_GATE_SMTP_PASSWORD=
# SEMEAI_GATE_SMTP_TLS=true

# Authenticated Repository Workspace (GitHub App; values intentionally blank)
SEMEAI_GITHUB_CLIENT_ID=
SEMEAI_GITHUB_CLIENT_SECRET=
SEMEAI_GITHUB_APP_ID=
SEMEAI_GITHUB_APP_SLUG=
SEMEAI_GITHUB_PRIVATE_KEY_PATH=
SEMEAI_GITHUB_CALLBACK_URL=
SEMEAI_GITHUB_SETUP_URL=
SEMEAI_SESSION_COOKIE_SECRET=
SEMEAI_BENCHMARK_WORKSPACE_DIR=
SEMEAI_BENCHMARK_CORE_PATH=
# Optional deployment pin for the exact benchmark.js bytes.
SEMEAI_BENCHMARK_CORE_SHA256=
# Optional; defaults to node.
SEMEAI_NODE_BINARY=
